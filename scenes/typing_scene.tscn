script/source = "extends Button
@export var grabs_focus: bool = false

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if grabs_focus:
		grab_focus()


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func load_new_scene(path: String):
	get_tree().change_scene_to_file(path)
"

[sub_resource type="GDScript" id="GDScript_an0yl"]
script/source = "extends RichTextLabel

var goal_word:String
var untyped_colour:String
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	#the normal grey doesn't show up well on the medium ui, so I made it a different colour on medium
	if Game.difficulty == \"medium\":
		untyped_colour = \"#7c7c7c\"
	else:
		untyped_colour = \"gray\"


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass



func resize_richtext():
	#if the text makes the box larger than it's default size, the font is decreased in increments of 16
	add_theme_font_size_override(\"normal_font_size\", 200)
	while size.y > 265:
		add_theme_font_size_override(\"normal_font_size\", get_theme_font_size(\"normal_font_size\") - 16)

func _on_input_box_text_changed(new_text: String) -> void:
	var coloured_text:String = \"\"
	var i:int = 0
	var goal_character:String = \"\"
	var current_colour:String = \"\"
	#for each charcater in the input box text it is either made red or white
	#red if it is accurate to the equivilent character in the goal word, red if not
	#if it goes out of bounds for the goal word, it is red
	#once all characters in the inputted text are done, the remainder of the goal word is added in grey
	#adds [/color] if it needs to change colour, to end that part, and adds a new [color=colour] to set the new colour
	for character in new_text:
		#if in bounds gets the character it should be
		if len(goal_word) - 1 >= i:
			goal_character = goal_word[i]
		else:
			goal_character = \"oob\"
		#if the character's position is out of bounds of the goal word, or isn't the goal character, it is made red
		if len(goal_word) - 1 < i or character != goal_character:
			if current_colour != \"red\":
				if i == 0:
					coloured_text += \"\".join([\"[color=red]\", character])
				else:
					coloured_text += \"\".join([\"[/color][color=red]\", character])
				current_colour = \"red\"
			else:
				coloured_text += character
		#if it is in the correct place, it is made white
		else:
			if current_colour != \"white\":
				if i == 0:
					coloured_text += \"\".join([\"[color=white]\", character])
				else:
					coloured_text += \"\".join([\"[/color][color=white]\", character])
				current_colour = \"white\"
			else:
				coloured_text += character
		#i is the index, used for both the input text and goal word character to be compared to each other
		i += 1
	if len(goal_word) > i:
		#adds the rest of the goal word to the end
		coloured_text += \"[color=%s]\" % untyped_colour
		coloured_text += goal_word.right(len(goal_word) - (i))
	coloured_text += \"[/color]\"
		
	#coloured_text = coloured_text.right(-8)
	print(coloured_text)
	text = coloured_text
	resize_richtext()
"

[sub_resource type="GDScript" id="GDScript_qa1tm"]
script/source = "extends Node2D
var random = RandomNumberGenerator.new()
var state: String = \"starting\"
var bob_moving:bool = false
var min_bob_distance: int = 0
var max_bob_distance: int = 0

func _ready() -> void:
	$Background.texture = load(\"res://assets/ui/backgrounds/%s_background.png\" % Game.difficulty)
	$Foreground.texture = load(\"res://assets/ui/backgrounds/%s_foreground.png\" % Game.difficulty)
	if Game.difficulty == \"hard\":
		$Midground.visible = true
	if Game.difficulty != \"easy\":
		var ship_sway_distance:int
		var ship_sway_tween
		if Game.difficulty == \"medium\":
			ship_sway_distance = 10
		elif Game.difficulty == \"hard\":
			ship_sway_distance = 20
		while true:
			ship_sway_tween = create_tween()
			ship_sway_tween.tween_property($Foreground, \"position\", Vector2(randi_range(-ship_sway_distance, ship_sway_distance), randi_range(0, ship_sway_distance * 2)), randf_range(1, 3))
			await ship_sway_tween.finished
			
func _process(delta: float) -> void:
	state = get_parent().state
	$Line2D.points[1] = $Bob.position + Vector2(4, -70)
	if state == \"waiting\":
		min_bob_distance = -50
		max_bob_distance = 50
	if state == \"typing\":
		min_bob_distance = -15
		max_bob_distance = 15
	if (state == \"waiting\" or state == \"typing\") and not bob_moving:
		#once the bob is static it is then moved to a random point over a random amount of time
		bob_moving = true
		var bob_movement_tween = create_tween()
		bob_movement_tween.tween_property($Bob, \"position\", get_bob_final_pos(), random.randf_range(0.6, 1))
		#once the tween finishes the flag is made false, so it can be started again
		await bob_movement_tween.finished
		bob_moving = false


func clamp(n, min, max):
	if n > max:
		return max
	elif min > n:
		return min
	else:
		return n


func get_bob_final_pos():
	#returns a point a random amount away from the bob, within certain a certain area
	var final_pos = Vector2(0, 0)
	final_pos.x = clamp($Bob.position.x + random.randi_range(min_bob_distance, max_bob_distance), 250, 1670)
	final_pos.y = clamp($Bob.position.y + random.randi_range(min_bob_distance, max_bob_distance), 100, 700)
	return final_pos
"

[sub_resource type="GDScript" id="GDScript_qwf22"]
script/source = "extends ColorRect
var r = RandomNumberGenerator.new()

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if Game.difficulty == \"hard\":
		visible = true
		color = Color(0.75, 0.75, 0.75)
		while true:
			#changes the colour to look like lightning striking
			await get_tree().create_timer(r.randf_range(3, 10)).timeout
			strike()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass

func strike():
	var tweener
	tweener = create_tween()
	tweener.tween_property(self, \"color\", Color(1, 1, 1), r.randf_range(0.1, 0.2))
	await tweener.finished
	await get_tree().create_timer(r.randf_range(0.1, 0.15)).timeout
	tweener = create_tween()
	tweener.tween_property(self, \"color\", Color(0.75, 0.75, 0.75), r.randf_range(0.05, 0.15))
	await tweener.finished
"

[sub_resource type="GDScript" id="GDScript_xga0i"]
script/source = "extends TextureRect


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var waves_tween
	var wave_distance = 20
	while true:
		waves_tween = create_tween()
		waves_tween.tween_property(self, \"position\", Vector2(randi_range(-wave_distance, wave_distance) - 20, randi_range(0, wave_distance * 2)), randf_range(1, 3))
		await waves_tween.finished

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

